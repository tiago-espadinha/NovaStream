# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Signs session tokens. Accounts and saving to an account stay off until this is set.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Failed password attempts allowed per account and per IP within the window (seconds)
# before sign-in, password change and account deletion answer 429. Lower them to try the message.
PASSWORD_ATTEMPTS_PER_ACCOUNT=5
PASSWORD_ATTEMPTS_PER_IP=20
PASSWORD_ATTEMPT_WINDOW_SECONDS=900

# Sign-ups allowed per IP within the window (seconds), whether the email is new or taken,
# before sign-up answers 429. Keeps the "email already exists" answer from listing accounts.
SIGNUP_ATTEMPTS_PER_IP=10
SIGNUP_ATTEMPT_WINDOW_SECONDS=3600

# Upstash Redis (free tier) for users when deployed; leave empty locally to use src/db/data.json.
# Vercel's Upstash integration sets KV_REST_API_URL/KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# TMDb — https://www.themoviedb.org/settings/api (free, instant approval)
TMDB_API_KEY=

# RAWG — https://rawg.io/apidocs (free, 20k requests/month)
RAWG_API_KEY=

# Last.fm — https://www.last.fm/api/account/create (powers music search, detail, and trending)
LASTFM_API_KEY=

# Books come from Open Library, which needs no API key.
