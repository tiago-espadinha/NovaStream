# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Signs session tokens. Accounts and saving to an account stay off until this is set.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# TMDb — https://www.themoviedb.org/settings/api (free, instant approval)
TMDB_API_KEY=

# RAWG — https://rawg.io/apidocs (free, 20k requests/month)
RAWG_API_KEY=

# Last.fm — https://www.last.fm/api/account/create (powers music search, detail, and trending)
LASTFM_API_KEY=

# Books come from Open Library, which needs no API key.
